# Required for real search results. Create a key in Google Cloud Console with the
# YouTube Data API v3 enabled: https://developers.google.com/youtube/v3/getting-started
# Without this, the app runs and shows an honest "search isn't configured" state.
YOUTUBE_API_KEY=

# Optional. Enables LLM-based query understanding (subject/topic/duration extraction)
# via the Anthropic API. Without it, a regex-based heuristic parser is used instead -
# search still works, just with cruder query interpretation.
ANTHROPIC_API_KEY=

# Optional: AI video breakdown for public YouTube videos through Gemini - detects the kind of
# video, suggests highlights to clip, and maps spoken topics.
# Obtain a key at https://aistudio.google.com/apikey; keep it server-side.
# Start the website and the analysis worker together with: npm run dev:all (Node 24+).
GEMINI_API_KEY=
GEMINI_VIDEO_MODEL=gemini-3.8-flash
# Optional comma-separated Gemini 3.x Flash models to use when the primary model's daily quota is
# used up. Each model has its own quota (the free tier allowed 20 requests/day per model when checked).
# GEMINI_FALLBACK_MODELS=gemini-3.7-flash
# Seconds of video per Gemini request (300-3600). Larger means fewer requests: at 3600, videos up
# to an hour are analyzed in a single request.
# ANALYSIS_WINDOW_SECONDS=3600
# Sections of a long video analyzed at the same time (1-4).
# ANALYSIS_CONCURRENCY=2
# The website and worker must use the same writable local directory.
# ANALYSIS_DATA_DIR=.data/analysis

# Optional. Adds Twitch as a second discovery source (channel search -> that channel's
# videos and official clips). Register an app at https://dev.twitch.tv/console/apps.
# Without them, Twitch results are simply omitted with a "not configured" notice.
# Note: Twitch has no full-text topic search, so this only resolves queries that name
# a channel/person closely matching a real Twitch channel name.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Kick is not integrated: as of this writing Kick has no official public API for search,
# VODs, or clips (only livestream/channel/chat/category endpoints). Adding Kick discovery
# would currently require scraping or a third-party API, which this project does not do.

# Not yet wired into the running app (see README "What's implemented vs deferred").
# Reserved for the auth/projects/transcripts phase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
