# Required for real search results. Create a key in Google Cloud Console with the
# YouTube Data API v3 enabled: https://developers.google.com/youtube/v3/getting-started
# Without this, the app runs and shows an honest "search isn't configured" state.
YOUTUBE_API_KEY=

# Optional. Enables LLM-based query understanding (subject/topic/duration extraction) via the
# Anthropic API, and runs the transcript and cross-check roles of AI video analysis on Claude.
# Without it, search uses a regex-based heuristic parser and analysis runs entirely on Gemini.
ANTHROPIC_API_KEY=

# Optional: AI video breakdown for public YouTube videos. Several models cowork by role:
#   transcript  - reads the captions for spoken moments and topics, and plans each job
#   cross-check - checks every spoken moment against the captions (keep / revise / reject)
#   footage     - Gemini watches the public YouTube video for moments that are seen, not said.
#                 Skipped for speech-led videos such as podcasts and talks (see ANALYSIS_VISUAL_PASS).
# With both keys, Claude handles transcript and cross-check with Gemini as their fallback. With only
# GEMINI_API_KEY, Gemini fills every role. With only ANTHROPIC_API_KEY, footage isn't scanned.
# The website starts the analysis worker automatically (Node 24+). To run the worker separately,
# set ANALYSIS_WORKER_AUTOSTART=0 and use: npm run analysis:worker
# ANALYSIS_WORKER_AUTOSTART=1
# Obtain a Gemini key at https://aistudio.google.com/apikey; keep it server-side.
GEMINI_API_KEY=
GEMINI_VIDEO_MODEL=gemini-3.8-flash
# Optional comma-separated Gemini 3.x Flash models to use when the primary model's daily quota is
# used up or transient errors persist after retries. Quotas vary by model and account.
# GEMINI_FALLBACK_MODELS=gemini-3.7-flash
# Claude models for the text roles; both default to claude-opus-5 when ANTHROPIC_API_KEY is set.
# claude-haiku-4-5 is a faster, cheaper transcript reader. A gemini-... model ID also works here.
# ANALYSIS_READER_MODEL=claude-opus-5
# ANALYSIS_REVIEWER_MODEL=claude-opus-5
# auto (default): scan footage when moments are likely visual or captions are sparse. Or: always, off.
# ANALYSIS_VISUAL_PASS=auto
# Required for automatic highlights: fetch existing YouTube captions via https://docs.supadata.ai/get-transcript.
# No AI transcription fallback. Without this key, caption analysis shows a setup message.
SUPADATA_API_KEY=
# Seconds per section (300-3600); default 600. All sections are analyzed in parallel.
# ANALYSIS_WINDOW_SECONDS=600
# Gemini requests sent at the same time (1-4). Claude requests run up to 4 at a time.
# ANALYSIS_CONCURRENCY=2
# The website and worker must use the same writable local directory.
# ANALYSIS_DATA_DIR=.data/analysis

# Optional. Adds Twitch as a second discovery source (channel search -> that channel's
# videos and official clips). Register an app at https://dev.twitch.tv/console/apps.
# Without them, Twitch results are simply omitted with a "not configured" notice.
# Note: Twitch has no full-text topic search, so this only resolves queries that name
# a channel/person closely matching a real Twitch channel name.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Kick is not integrated: as of this writing Kick has no official public API for search,
# VODs, or clips (only livestream/channel/chat/category endpoints). Adding Kick discovery
# would currently require scraping or a third-party API, which this project does not do.

# Not yet wired into the running app (see README "What's implemented vs deferred").
# Reserved for the auth/projects/transcripts phase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
